<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.coffeeshop.CoffeeInfoController">

    <children>

        <!-- Background Image -->
        <ImageView fitWidth="1000.0"
                   fitHeight="650.0"
                   preserveRatio="false"
                   pickOnBounds="true"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <image>
                <Image url="@Signup.jpeg"/>
            </image>

        </ImageView>


        <!-- Content VBox -->
        <VBox alignment="CENTER"
              spacing="20.0"
              prefHeight="500.0"
              prefWidth="700.0"
              layoutX="150.0"
              layoutY="75.0"
              style="-fx-background-color: beige;
                     -fx-background-radius: 20px;">

            <children>

                <Label text="Coffee Information"
                       textFill="#5e1515">

                    <font>
                        <Font name="Georgia Bold"
                              size="30.0"/>
                    </font>

                </Label>


                <ScrollPane fitToWidth="true"
                            prefWidth="620.0"
                            prefHeight="280.0"
                            style="-fx-background-color: transparent;">

                    <content>

                        <Label fx:id="infoLabel"
                               text="Click the button to load coffee information."
                               wrapText="true"
                               prefWidth="580.0"
                               alignment="CENTER">

                            <font>
                                <Font name="Georgia"
                                      size="18.0"/>
                            </font>

                        </Label>

                    </content>

                </ScrollPane>


                <Button text="Get Coffee Info"
                        onAction="#getCoffeeInfo"
                        style="-fx-background-color: #79492F;
                               -fx-background-radius: 15px;
                               -fx-text-fill: beige;">

                    <font>
                        <Font name="Georgia Bold"
                              size="18.0"/>
                    </font>

                </Button>


                <Button text="Back"
                        onAction="#back"
                        style="-fx-background-color: #79492F;
                               -fx-background-radius: 15px;
                               -fx-text-fill: beige;">

                    <font>
                        <Font name="Georgia Bold"
                              size="18.0"/>
                    </font>

                </Button>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</AnchorPane>