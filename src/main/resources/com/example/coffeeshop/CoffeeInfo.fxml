<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="650.0"
      prefWidth="1000.0"
      spacing="15.0"
      style="-fx-background-color: beige;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.coffeeshop.CoffeeInfoController">

    <children>

        <!-- TITLE -->
        <Label text="Coffee Information"
               textFill="#5e1515">

            <font>
                <Font name="Georgia Bold"
                      size="30.0"/>
            </font>

        </Label>


        <!-- SCROLLABLE COFFEE INFORMATION -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    prefHeight="470.0"
                    prefWidth="900.0"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">

            <content>

                <VBox fx:id="coffeeBox"
                      alignment="TOP_LEFT"
                      spacing="20.0"
                      prefWidth="850.0"
                      style="-fx-background-color: beige;">

                    <padding>
                        <Insets top="15.0"
                                right="25.0"
                                bottom="15.0"
                                left="25.0"/>
                    </padding>

                </VBox>

            </content>

        </ScrollPane>


        <!-- GET INFO BUTTON -->
        <Button mnemonicParsing="false"
                onAction="#getCoffeeInfo"
                prefHeight="45.0"
                prefWidth="230.0"
                style="-fx-background-color: #79492F;
                       -fx-background-radius: 15px;
                       -fx-text-fill: beige;"
                text="Get Coffee Info">

            <font>
                <Font name="Georgia Bold"
                      size="18.0"/>
            </font>

        </Button>


        <!-- BACK BUTTON -->
        <Button mnemonicParsing="false"
                onAction="#back"
                prefHeight="45.0"
                prefWidth="120.0"
                style="-fx-background-color: #79492F;
                       -fx-background-radius: 15px;
                       -fx-text-fill: beige;"
                text="Back">

            <font>
                <Font name="Georgia Bold"
                      size="18.0"/>
            </font>

        </Button>

    </children>


    <padding>
        <Insets top="20.0"
                right="30.0"
                bottom="20.0"
                left="30.0"/>
    </padding>

</VBox>