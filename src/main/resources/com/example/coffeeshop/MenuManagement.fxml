<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="550.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.coffeeshop.MenuManagementController">

   <children>

      <!-- Background -->
      <ImageView fx:id="backgroundImage"
                 fitHeight="550.0"
                 fitWidth="1000.0"
                 layoutX="352.0"
                 layoutY="217.0"
                 pickOnBounds="true"
                 AnchorPane.bottomAnchor="0.0"
                 AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0"
                 AnchorPane.topAnchor="0.0">

         <image>
            <Image url="@Signup.jpeg" />
         </image>

      </ImageView>


      <!-- Main Beige Box -->
      <VBox alignment="TOP_CENTER"
            layoutX="23.0"
            layoutY="29.0"
            prefHeight="492.0"
            prefWidth="946.0"
            style="-fx-background-color: beige; -fx-background-radius: 15px;">

         <children>

            <!-- Title -->
            <Label text="Menu Management"
                   textFill="#430b0b">

               <font>
                  <Font name="Georgia Bold" size="28.0" />
               </font>

               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>

            </Label>


            <!-- Menu Table -->
            <TableView fx:id="menuTable"
                       prefHeight="200.0"
                       prefWidth="200.0"
                       style="-fx-background-color: #F5F1D8; -fx-background-radius: 12; -fx-border-color: #8B5E3C; -fx-border-width: 2; -fx-border-radius: 12;"
                       stylesheets="@style.css">

               <columns>

                  <TableColumn fx:id="idColumn"
                               prefWidth="300.0"
                               text="ID" />

                  <TableColumn fx:id="nameColumn"
                               prefWidth="350.0"
                               text="Coffee Name" />

                  <TableColumn fx:id="priceColumn"
                               prefWidth="300.0"
                               text="Price" />

               </columns>

               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>

            </TableView>


            <!-- Coffee Name -->
            <HBox prefHeight="40.0"
                  prefWidth="200.0"
                  spacing="30.0">

               <children>

                  <Label text="Coffee Name:"
                         textFill="#5e0e0e">

                     <font>
                        <Font name="Georgia Bold" size="18.0" />
                     </font>

                  </Label>

                  <TextField fx:id="nameField"
                             prefWidth="300.0" />

               </children>

               <VBox.margin>
                  <Insets left="40.0" top="25.0" />
               </VBox.margin>

            </HBox>


            <!-- Price -->
            <HBox prefHeight="40.0"
                  prefWidth="200.0"
                  spacing="50.0">

               <children>

                  <Label text="Price:"
                         textFill="#5e0e0e">

                     <font>
                        <Font name="Georgia Bold" size="20.0" />
                     </font>

                  </Label>

                  <TextField fx:id="priceField"
                             prefWidth="300.0" />

               </children>

               <VBox.margin>
                  <Insets left="40.0" top="10.0" />
               </VBox.margin>

            </HBox>


            <!-- Add / Update / Delete Buttons -->
            <HBox alignment="CENTER"
                  spacing="20.0">

               <children>

                  <Button mnemonicParsing="false"
                          onAction="#addMenuItem"
                          style="-fx-background-color: #79492F; -fx-background-radius: 15px; -fx-text-fill: beige;"
                          text="Add">

                     <font>
                        <Font name="Georgia Bold" size="16.0" />
                     </font>

                  </Button>


                  <Button mnemonicParsing="false"
                          onAction="#updatePrice"
                          style="-fx-background-color: #79492F; -fx-background-radius: 15px; -fx-text-fill: beige;"
                          text="Update Price">

                     <font>
                        <Font name="Georgia Bold" size="16.0" />
                     </font>

                  </Button>


                  <Button mnemonicParsing="false"
                          onAction="#deleteMenuItem"
                          style="-fx-background-color: #79492F; -fx-background-radius: 15px; -fx-text-fill: beige;"
                          text="Delete">

                     <font>
                        <Font name="Georgia Bold" size="16.0" />
                     </font>

                  </Button>

               </children>

               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>

            </HBox>


            <!-- Back Button -->
            <Button mnemonicParsing="false"
                    onAction="#goBack"
                    style="-fx-background-color: #79492F; -fx-background-radius: 15px; -fx-text-fill: beige;"
                    text="&lt;- Back">

               <font>
                  <Font name="Georgia Bold" size="20.0" />
               </font>

               <VBox.margin>
                  <Insets right="600.0" top="10.0" />
               </VBox.margin>

            </Button>

         </children>

      </VBox>

   </children>

</AnchorPane>